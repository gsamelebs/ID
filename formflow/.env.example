# Application
FRONTEND_PORT=80
BACKEND_PORT=3000
APP_VERSION=dev
API_URL=/
VITE_API_URL=/

# Database
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=formflow
DATABASE_USER=formflow_user
DATABASE_PASSWORD=CHANGE_ME

# Production image references used by CI/CD and VM deployment
DOCKERHUB_USERNAME=your-dockerhub-username
FRONTEND_IMAGE=your-dockerhub-username/formflow-frontend:dev
BACKEND_IMAGE=your-dockerhub-username/formflow-backend:dev
